	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"postinstall": "mkdir -p static/wasm && cp node_modules/web-tree-sitter/web-tree-sitter.wasm static/wasm/tree-sitter.wasm && cp node_modules/@tree-sitter-grammars/tree-sitter-markdown/tree-sitter-markdown/tree-sitter-markdown.wasm static/wasm/tree-sitter-markdown.wasm && cp node_modules/@tree-sitter-grammars/tree-sitter-markdown/tree-sitter-markdown-inline/tree-sitter-markdown_inline.wasm static/wasm/tree-sitter-markdown-inline.wasm"
	},
