{
	"name": "desktop",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"main": "./dist-main/main.js",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"build": "vite build && tsc -p tsconfig.main.json",
		"start": "electron . --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"electron": "^34.0.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"tailwindcss": "^4.2.2",
		"@types/node": "^25.9.1",
		"@types/wicg-file-system-access": "^2023.10.7"
	},
	"dependencies": {
		"@np/core": "workspace:*",
		"@np/ui": "workspace:*",
		"phosphor-svelte": "^3.1.0"
	}
}
