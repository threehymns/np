{
	"name": "desktop",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"main": "./dist-main/main.js",
	"scripts": {
		"dev": "bun run scripts/dev.ts",
		"build": "vite build && tsc -p tsconfig.main.json",
		"dist": "electron-builder --publish never",
		"start": "electron . --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations",
		"check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.test.json"
	},
	"build": {
		"appId": "com.github.threehymns.np",
		"productName": "np",
		"directories": {
			"output": "dist-electron"
		},
		"files": [
			"dist/**",
			"dist-main/**",
			"package.json"
		],
		"asarUnpack": [
			"node_modules/@parcel/**/*",
			"node_modules/@vtsls/**/*",
			"node_modules/@vscode/**/*",
			"node_modules/vscode-*/**/*",
			"node_modules/semver/**/*",
			"node_modules/jsonc-parser/**/*",
			"node_modules/source-map-support/**/*",
			"node_modules/source-map/**/*",
			"node_modules/buffer-from/**/*",
			"node_modules/typescript/**/*",
			"node_modules/lru-cache/**/*",
			"node_modules/yallist/**/*"
		],
		"mac": {
			"target": [
				"dmg",
				"zip"
			]
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			]
		},
		"win": {
			"target": [
				"nsis"
			]
		}
	},
	"devDependencies": {
		"electron": "^45.0.0",
		"electron-builder": "^26.0.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"tailwindcss": "^4.2.2",
		"@types/bun": "^1.2.0",
		"@types/node": "^25.9.1",
		"@types/wicg-file-system-access": "^2023.10.7"
	},
	"dependencies": {
		"@codemirror/view": "^6.43.8",
		"@np/core": "workspace:*",
		"@np/ui": "workspace:*",
		"@parcel/watcher": "^2.6.0",
		"@vtsls/language-server": "0.3.0",
		"jsonc-parser": "^3.3.1",
		"phosphor-svelte": "^3.1.0"
	}
}
