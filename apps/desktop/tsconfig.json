{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"types": ["node", "wicg-file-system-access", "vite/client"]
	},
	"include": ["src/renderer/**/*"],
	"exclude": ["**/*.test.ts"]
}
